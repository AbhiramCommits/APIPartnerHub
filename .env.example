# APIPartnerHub local configuration. Copy to .env before running.
# Compose host ports (defaults match the spec; override if the port is taken locally).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Application
ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://apph:apph@localhost:5432/apph
REDIS_URL=redis://localhost:6379/0

# HS256 signing key for OAuth access tokens. Generate a long random value in production.
JWT_SECRET=dev-only-change-me-8f3b9c1d7e5a4b2f
JWT_TTL_SECONDS=3600
JWT_ISSUER=apipartnerhub
JWT_AUDIENCE=apipartnerhub-api

# Rate limiting fallback used when a partner row has no explicit limit.
RATE_LIMIT_DEFAULT_RPM=60

# Public URLs baked into OpenAPI servers and error doc links.
API_BASE_URL=http://localhost:8000
DOC_BASE_URL=https://docs.apipartnerhub.dev
