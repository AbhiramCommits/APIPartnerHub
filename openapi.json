{
  "openapi": "3.1.0",
  "info": {
    "title": "APIPartnerHub Partner API",
    "description": "\nPartner-facing advertising data API.\n\n**Authentication** \u2014 send either a long-lived `X-API-Key` credential or an OAuth 2.0\nclient-credentials bearer token (`Authorization: Bearer <jwt>`). Scopes are enforced per\nendpoint. Mint tokens with `POST /oauth/token`.\n\n**Reliability** \u2014 every `/v1` response carries `RateLimit-Limit`, `RateLimit-Remaining` and\n`RateLimit-Reset`, plus an `X-Request-ID`. Failures use one machine-readable envelope with a\nstable `code`, a `doc_url` and the request id for support escalation.\n\n**Bulk data** \u2014 campaigns can be created in bulk from CSV and reports can be streamed as CSV\nfor spreadsheet workflows.\n",
    "contact": {
      "name": "Partner Solutions Engineering",
      "email": "partners@apipartnerhub.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    },
    {
      "url": "https://api.apipartnerhub.dev",
      "description": "Production"
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "OAuth"
        ],
        "summary": "Exchange client credentials for an access token",
        "description": "RFC 6749 client-credentials grant. Send `application/x-www-form-urlencoded` fields `grant_type=client_credentials`, `client_id`, `client_secret` and optionally `scope`.",
        "operationId": "issue_token_oauth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_oauth_token_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "unsupported_grant_type or invalid_scope (RFC 6749 shape)"
          },
          "401": {
            "description": "invalid_client (RFC 6749 shape)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/partners/me": {
      "get": {
        "tags": [
          "Partners"
        ],
        "summary": "Get the authenticated partner",
        "description": "Returns the caller's profile, commercial tier, effective rate limit (steady and burst), granted scopes and the auth mode used for this request.",
        "operationId": "get_me_v1_partners_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerProfile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "partner:read"
            ]
          }
        ]
      }
    },
    "/v1/campaigns": {
      "get": {
        "tags": [
          "Campaigns"
        ],
        "summary": "List campaigns",
        "description": "Cursor-paginated campaign list scoped to the authenticated partner. Pages are ordered by `created_at` descending, then id descending. Pass the opaque `next_cursor` back as `cursor` until `has_more` is false.",
        "operationId": "list_campaigns_v1_campaigns_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size (max 100).",
              "default": 25,
              "title": "Limit"
            },
            "description": "Page size (max 100)."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from `next_cursor`.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from `next_cursor`."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "paused",
                    "ended"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by delivery status.",
              "title": "Status"
            },
            "description": "Filter by delivery status."
          },
          {
            "name": "objective",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "awareness",
                    "consideration",
                    "conversions",
                    "retention"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by optimization objective.",
              "title": "Objective"
            },
            "description": "Filter by optimization objective."
          },
          {
            "name": "name_contains",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring match on name.",
              "title": "Name Contains"
            },
            "description": "Case-insensitive substring match on name."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "campaigns:read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Create a campaign",
        "description": "Creates a campaign for the authenticated partner. Send an optional `Idempotency-Key` header; replaying the same key with the identical body returns the original response and `Idempotency-Replayed: true`. Reusing the key with a different body returns 409.",
        "operationId": "create_campaign_v1_campaigns_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client-generated key (<=255 chars) that makes this POST safely retryable.",
              "title": "Idempotency-Key"
            },
            "description": "Client-generated key (<=255 chars) that makes this POST safely retryable."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignOut"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay of a previously created campaign."
          },
          "409": {
            "description": "Idempotency-Key reused with a different request body."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "campaigns:write"
            ]
          }
        ]
      }
    },
    "/v1/campaigns/{campaign_id}": {
      "get": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Get one campaign",
        "description": "Returns the campaign if it belongs to the authenticated partner; otherwise 404.",
        "operationId": "get_campaign_v1_campaigns__campaign_id__get",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Campaign identifier owned by the caller.",
              "title": "Campaign Id"
            },
            "description": "Campaign identifier owned by the caller."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignOut"
                }
              }
            }
          },
          "404": {
            "description": "Campaign not found for this partner."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "campaigns:read"
            ]
          }
        ]
      },
      "patch": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Partially update a campaign",
        "description": "Applies only the provided fields. If `If-Match` is sent it must equal the current ETag from GET or a previous PATCH, otherwise the update is rejected with 409 so concurrent writers cannot silently overwrite each other.",
        "operationId": "update_campaign_v1_campaigns__campaign_id__patch",
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Campaign identifier owned by the caller.",
              "title": "Campaign Id"
            },
            "description": "Campaign identifier owned by the caller."
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current ETag; `*` matches any existing resource.",
              "title": "If-Match"
            },
            "description": "Current ETag; `*` matches any existing resource."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampaignOut"
                }
              }
            }
          },
          "404": {
            "description": "Campaign not found for this partner."
          },
          "409": {
            "description": "If-Match conflicted with the current ETag."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "campaigns:write"
            ]
          }
        ]
      }
    },
    "/v1/reports/metrics": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Aggregate campaign metrics",
        "description": "Aggregates daily metrics for the caller's campaigns over an inclusive date window. Group by `day` or `campaign`. Raw metrics are selected with `metrics`; CTR, CPC, CPM and CVR are always computed server-side. Use `format=csv` for a streamed download.",
        "operationId": "get_metrics_v1_reports_metrics_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive start date (YYYY-MM-DD).",
              "title": "Start Date"
            },
            "description": "Inclusive start date (YYYY-MM-DD)."
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive end date (YYYY-MM-DD).",
              "title": "End Date"
            },
            "description": "Inclusive end date (YYYY-MM-DD)."
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "day",
                "campaign"
              ],
              "type": "string",
              "description": "Aggregation bucket.",
              "default": "day",
              "title": "Group By"
            },
            "description": "Aggregation bucket."
          },
          {
            "name": "metrics",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated raw metrics: impressions, clicks, spend_cents, conversions.",
              "default": "impressions,clicks,spend_cents,conversions",
              "title": "Metrics"
            },
            "description": "Comma-separated raw metrics: impressions, clicks, spend_cents, conversions."
          },
          {
            "name": "campaign_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional campaign id filter. Repeat the parameter for multiple ids.",
              "title": "Campaign Ids"
            },
            "description": "Optional campaign id filter. Repeat the parameter for multiple ids."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "json",
                "csv"
              ],
              "type": "string",
              "description": "Response format.",
              "default": "json",
              "title": "Format"
            },
            "description": "Response format."
          }
        ],
        "responses": {
          "200": {
            "description": "JSON report, or a CSV stream when format=csv.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Invalid metrics, dates or date window."
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "reports:read"
            ]
          }
        ]
      }
    },
    "/v1/bulk/campaigns": {
      "post": {
        "tags": [
          "Bulk"
        ],
        "summary": "Bulk create campaigns from CSV",
        "description": "Upload a UTF-8 CSV with columns `name,status,daily_budget_cents,objective`. Valid rows are created; invalid rows are reported with row numbers and field names. Returns 200 when every row is accepted and 207 when any row is rejected.",
        "operationId": "bulk_campaigns_v1_bulk_campaigns_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_bulk_campaigns_v1_bulk_campaigns_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResult"
                }
              }
            }
          },
          "207": {
            "description": "Partial success: at least one row was rejected."
          },
          "422": {
            "description": "Malformed header, empty file or oversized upload."
          },
          "401": {
            "description": "Missing or invalid credentials (AUTH-001)."
          },
          "403": {
            "description": "Credential lacks the required scope (SCOPE-001)."
          },
          "429": {
            "description": "Rate limit exceeded (RL-001). Retry after the Retry-After seconds."
          },
          "500": {
            "description": "Unexpected server error (INTERNAL-001)."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "OAuth2": [
              "bulk:write"
            ]
          }
        ]
      }
    },
