      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Pings Postgres and Redis. Returns 503 when a dependency is down.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
