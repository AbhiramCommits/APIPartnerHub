  },
  "components": {
    "schemas": {
      "Body_bulk_campaigns_v1_bulk_campaigns_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CSV file of campaigns to create."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_bulk_campaigns_v1_bulk_campaigns_post",
        "description": "Multipart form body containing the CSV file in the `file` field."
      },
      "Body_issue_token_oauth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
